# Copy to .env beside config.yaml (or beside the installed EXE).
# Do not commit .env. Process environment values override this file.
# Keys saved in the GUI / Windows Credential Manager override environment keys.
# All four service keys can be configured through Settings without this file.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Exact ID from https://openrouter.ai/models. Set a model before starting.
OPENROUTER_MODEL=
# Optional. Leave empty for text-only interviews; choose a vision-capable model for screenshots.
OPENROUTER_VISION_MODEL=
OPENROUTER_MAX_TOKENS=1200
OPENROUTER_TEMPERATURE=0.55
OPENROUTER_TIMEOUT_SECONDS=120

# Local alternative: set LLM_PROVIDER=lmstudio and fill these fields.
LMSTUDIO_HOST=127.0.0.1
LMSTUDIO_PORT=1234
LMSTUDIO_API_TOKEN=
LMSTUDIO_MODEL=
LMSTUDIO_VISION_MODEL=

# RTX 3060 Ti / 8 GB starting profile: CUDA with INT8 weights and FP16 computation.
# RTX 5070 Ti also supports this profile. For CPU use STT_DEVICE=cpu, STT_COMPUTE_TYPE=int8.
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
STT_MODEL=large-v3-turbo
STT_LANGUAGE=auto
# Select audio devices in Settings and save, or uncomment IDs returned by diagnostics.
# SYSTEM_AUDIO_DEVICE=
# MICROPHONE_DEVICE=

MCP_BACKEND=native
# Official hosted Firecrawl + Upstash Context7 over HTTPS. No local MCP server or LM Studio needed.
# Keyless access has unpublished daily IP limits and may require an API key on your network.
# To replace defaults with your own trusted server definitions, uncomment:
# MCP_CONFIG=config/mcp.json
# CONTEXT7_API_KEY=
# Optional: a free Firecrawl account provides a documented monthly credit allowance.
# Leave unset for keyless access. A key uses that account's existing plan; no automatic upgrade.
# FIRECRAWL_API_KEY=
SEARCH_MODE=auto
SEARCH_TIMEOUT_SECONDS=10
